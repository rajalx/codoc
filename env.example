# Copy this file to .env and adjust for your PostgreSQL.
# Docker (see README): postgres / postgres / codoc on localhost:5432
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/codoc"

# Local dev: browsers connect to the sync service directly (port 3003).
# (Leave unset only when running behind the sandbox edge proxy.)
NEXT_PUBLIC_SYNC_URL="http://localhost:3003"
