generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A collaborative Markdown document.
///
/// Ownership split: during live editing, `content` and `revision` are
/// owned exclusively by the sync service (mini-services/sync-service,
/// socket.io on port 3003), which writes them via raw SQL alongside its
/// OperationEntry audit rows and DocumentVersion snapshots. The Next.js
/// REST API (src/app/api/documents...) only creates documents, reads
/// metadata for listing/preview, renames the title, and deletes the row
/// — it never writes `content` or `revision`.
model Document {
  /// UUID (v4) primary key, generated by Prisma on the client side.
  /// The sync service receives this id over socket.io; every version and
  /// operation row references it.
  id        String   @id @default(uuid())

  /// Display title. Renamed via PATCH /api/documents/[id]; truncated to
  /// 120 characters by that handler (the DB itself imposes no limit).
  title     String   @default("Untitled document")

  /// Current authoritative document body, stored as raw Markdown.
  /// Written only by the sync service as edits are applied; the REST API
  /// reads it for list previews and writes it once at creation time.
  content   String   @default("")

  /// Server-authoritative, monotonically increasing revision counter.
  /// Owned by the sync service (NOT the Next.js API): it increments the
  /// counter once per applied operation batch in total server order, uses
  /// it as the basis for OT (clients transform their ops from their base
  /// revision forward), and stamps every OperationEntry and
  /// DocumentVersion with the revision reached. Default 0 for newly
  /// created (REST-created) documents; the sync service seeds its
  /// in-memory state from this value on first subscriber.
  revision  Int      @default(0)

  /// Row creation time. Immutable in practice.
  createdAt DateTime @default(now())

  /// Display name of the user who created this document (client-claimed,
  /// no auth in this app). Documents with ownerName "" are "public" — only
  /// the seeded Welcome document uses this; everyone can see and join them.
  ownerName String   @default("")

  /// Short share code (8 lowercase chars). The owner hands it out; joining
  /// with it (POST /api/documents/join) adds the presenter as a collaborator
  /// with edit access. Nullable because legacy rows predate the feature;
  /// the share endpoint lazily generates a key for such rows.
  shareKey  String?  @unique

  /// Last-write timestamp, maintained by Prisma on every update through
  /// this client. Drives the "recently updated" ordering of
  /// GET /api/documents. Caveat: the sync service sets `updatedAt`
  /// directly in its raw SQL, so the two write paths stay consistent.
  updatedAt DateTime @updatedAt

  /// Version-timeline snapshots, ordered newest-first by the timeline
  /// query via the DocumentVersion index.
  versions    DocumentVersion[]
  /// Append-only operation audit log; the DB is the durable replay log
  /// for what the sync service applied in memory.
  operations  OperationEntry[]
  /// Users (display names) invited via the share key. Edit access.
  collaborators Collaborator[]
}

/// A snapshot in the version timeline, created exclusively by the sync
/// service: automatically every SNAPSHOT_EVERY_OPS (40) applied
/// operations, on a client's manual "save version", and whenever a
/// snapshot is restored (which also cuts a new snapshot documenting the
/// restore itself).
///
/// Snapshots are plain full-content copies, not diffs, so the timeline UI
/// can preview and restore from a single row.
model DocumentVersion {
  /// UUID (v4) primary key.
  id         String   @id @default(uuid())

  /// Owning document. Deleted with it (onDelete: Cascade) — deleting a
  /// document destroys its entire version history.
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  /// The server revision (Document.revision) at which this snapshot was
  /// taken. Labels in the timeline render as "v{revision}".
  revision   Int // server revision this snapshot was taken at

  /// Full document content at the snapshot point.
  content    String

  /// Human-readable snapshot label. "Autosave" for the automatic
  /// every-N-ops snapshots; the manual-save and restore flows pass
  /// user-facing labels instead.
  label      String   @default("Autosave")

  /// Display name of the user who triggered the snapshot — a display
  /// name, NOT a user id: this application has no authentication or
  /// user table, so identity is whatever name the client presented.
  /// "system" is used when no user action was involved.
  author     String   @default("system")

  /// When the snapshot was cut. Part of the timeline index below.
  createdAt  DateTime @default(now())

  /// Serves GET /api/documents/[id]/versions, which filters by
  /// documentId, orders by createdAt DESC, and takes the 100 newest
  /// rows. A plain (documentId) index could not satisfy the ordering
  /// without a sort step; the composite index gives the scan the exact
  /// filter + order shape the timeline query needs.
  @@index([documentId, createdAt])
}

/// Append-only audit log of every operation batch the sync engine applied,
/// written in the same transaction/flush path as the document content and
/// revision update. Row shape mirrors the OT operation format:
///   ops = [{ type: "insert", pos, text } | { type: "delete", pos, len }]
/// (`text` present on inserts, `len` on deletes). The log is the durable
/// record of what was applied in server order; it is not currently read
/// back for replay, only audited (and cascade-deleted with the document).
model OperationEntry {
  /// UUID (v4) primary key.
  id         String   @id @default(uuid())

  /// Owning document. Deleted with it (onDelete: Cascade) — deleting a
  /// document destroys its operation history too.
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  /// Server revision AFTER applying this batch: the sync service
  /// increments Document.revision per applied batch and stamps the log
  /// row with the resulting value.
  revision   Int // server revision AFTER applying this batch

  /// The applied batch, serialized as JSON:
  ///   [{ type: "insert", pos, text } | { type: "delete", pos, len }]
  /// Positions are in document coordinate space after the batch's own
  /// transforms have been applied by the sync engine.
  ops        Json // [{type:"insert"|"delete", pos, text?|len?}]

  /// Display name of the client that produced the batch — a display
  /// name, NOT a user id: this application has no authentication, so
  /// attribution is client-claimed and unverified.
  author     String

  /// When the batch was flushed to the database (batched writes may lag
  /// the in-memory application slightly).
  createdAt  DateTime @default(now())

  /// Serves per-document reads of the log ordered by revision, e.g.
  /// reconstructing the op history of one document (or fetching all
  /// entries for a document up to a given revision) without scanning
  /// unrelated documents first.
  @@index([documentId, revision])
}

/// An invited collaborator on a document. Joining with the document's
/// share key (POST /api/documents/join) creates one of these rows and
/// grants the invited user (edit access).
///
/// Identity model: `userName` is a display name, NOT a user id — this
/// application has no authentication, so identity is whatever name the
/// client presents. Uniqueness is per (document, name): re-joining with
/// the same share key is idempotent for the same display name.
model Collaborator {
  /// UUID (v4) primary key.
  id         String   @id @default(uuid())

  /// Owning document. Deleted with it (onDelete: Cascade) — deleting a
  /// document removes its share list too.
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  /// Display name of the invited user (client-claimed, no auth).
  userName   String

  /// When the invite was accepted (first join with the share key).
  addedAt    DateTime @default(now())

  /// One row per (document, display name): idempotent re-joins.
  @@unique([documentId, userName])
  /// Serves the "documents shared with me" home-screen query
  /// (GET /api/documents?user=...), which looks up by userName.
  @@index([userName])
}
